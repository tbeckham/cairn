sources:
  # Folder source — watches local corpus directories
  - name: work-docs
    type: folder
    path: corpus/work
    collection: work
    watch: true

  - name: personal-docs
    type: folder
    path: corpus/personal
    collection: personal
    watch: true

  # Git repo source — pulls and re-ingests on schedule
  # - name: my-repo
